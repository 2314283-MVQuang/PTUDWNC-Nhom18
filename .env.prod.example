# =============================================================================
#  Mẫu cấu hình production — Tuần 8 (Quang)
#  cp .env.prod.example .env.prod  → điền giá trị thật → KHÔNG commit .env.prod (đã có trong .gitignore)
#  Sinh khoá ngẫu nhiên: openssl rand -base64 48
# =============================================================================

# Địa chỉ người dùng truy cập (IP hoặc domain của máy chủ). Có HTTPS thì dùng https://
PUBLIC_WEB_URL=http://203.0.113.10:3000
PUBLIC_API_URL=http://203.0.113.10:5000/api/v1
PUBLIC_STORAGE_URL=http://203.0.113.10:9000

# Mật khẩu hạ tầng
POSTGRES_PASSWORD=doi-mat-khau-postgres
REDIS_PASSWORD=doi-mat-khau-redis
MINIO_ROOT_USER=culinaryadmin
MINIO_ROOT_PASSWORD=doi-mat-khau-minio-it-nhat-8-ky-tu
# Đăng nhập giao diện Seq (xem log) — user "admin"
SEQ_ADMIN_PASSWORD=doi-mat-khau-seq

# Khoá ký token — mỗi biến >= 32 ký tự ngẫu nhiên, KHÁC nhau
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu-1
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu-2

# Tài khoản Admin đầu tiên (đăng nhập xong vào /dashboard/categories để tạo danh mục)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Doi@MatKhau123

# SMTP gửi email chào mừng / đặt lại mật khẩu (vd Gmail: smtp.gmail.com, 587, StartTls, App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=ban@gmail.com
SMTP_PASSWORD=app-password-16-ky-tu
SMTP_FROM_EMAIL=ban@gmail.com

# Đăng nhập Google (tuỳ chọn — để trống thì ẩn nút Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
