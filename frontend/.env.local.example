# Copy file này thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local lên git)

# URL backend .NET (mục 8 - REST API spec)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Tùy chọn: URL riêng để Next.js server gọi backend trong Docker; không gửi ra trình duyệt.
API_INTERNAL_BASE_URL=

# Chạy `npx auth secret` để tự sinh giá trị này (Auth.js v5)
AUTH_SECRET=

# URL của chính app Next.js này khi chạy local
NEXTAUTH_URL=http://localhost:3000

# Chỉ hoạt động khi NODE_ENV=development. Production luôn dùng backend thật.
AUTH_DEMO_ENABLED=false

# Google OAuth Development: dùng client riêng của môi trường thử nghiệm.
# Production cấp GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET trong .env.prod trên máy chủ.
# Không dùng NEXT_PUBLIC_* cho secret; không cần secret khi build image.
# Hướng dẫn: spec/cau_hinh_google_website_chung.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
