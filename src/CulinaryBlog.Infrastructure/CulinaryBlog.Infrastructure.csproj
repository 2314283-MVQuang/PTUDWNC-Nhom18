<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CulinaryBlog.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phiên bản dưới đây là ước lượng tốt nhất (môi trường dựng scaffold không có internet để
         tra NuGet) — chạy `dotnet restore`, nếu lỗi version thì `dotnet add package <Tên>` để
         lấy bản mới nhất tương thích net10.0 + PostgreSQL 16. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <!-- Dùng để sinh dữ liệu mẫu ngẫu nhiên cho môi trường dev (xem Persistence/Seed/DbSeeder.cs) —
         theo đúng mục 4.4 tài liệu hướng dẫn ("Dữ liệu test/seed: dùng thư viện Bogus"). -->
    <PackageReference Include="Bogus" Version="35.6.1" />
    <!-- Tuần 3 (FR-OBS-001): health check PostgreSQL cho /health, /health/ready. -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <!-- Tuần 3 (FR-OBS-003): Npgsql tự phát Activity/trace cho mỗi câu lệnh SQL nó gửi xuống
         PostgreSQL — đây là cách thực tế để có "EF Core traces" (EF Core không tự phát trace
         riêng, mọi lệnh SQL cuối cùng đều đi qua Npgsql). Đăng ký nguồn trace này ở
         API/Program.cs bằng tracerBuilder.AddNpgsql(). -->
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CulinaryBlog.Application\CulinaryBlog.Application.csproj" />
  </ItemGroup>

</Project>
